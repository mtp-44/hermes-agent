<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Tailnet dashboard backend (admin SPA + /api/* + the /api/ws gateway the
         desktop client speaks), bound to the tailnet address with the auth gate
         on; credentials come from ~/.hermes/.env (HERMES_DASHBOARD_BASIC_AUTH_*).

         MUST run via the repo .venv python. Until 2026-09-24 this ran the
         ~/.local/bin/hermes shim, which then exec'd the separate
         ~/.hermes/hermes-agent upstream install, so the dashboard ran unpatched
         upstream code (HA-0006).

         The skip-build flag plus HERMES_WEB_DIST / HERMES_TUI_DIR point at a
         prebuilt release, so the dashboard never runs npm or esbuild inside the
         production checkout. Releases live in
         ~/state/releases/hermes-dashboard/releases/STAMP-SHA/ holding web_dist/
         and ui-tui/dist/entry.js; `current` is the live one. Rebuild from a clean
         `git archive` export of the deployed sha (npm ci and npm run build for
         the web workspace, npm install and npm run build for ui-tui), never
         in the repo. No double hyphens in this comment: XML forbids them and
         Python plistlib refuses the file.

         Install: cp launchd/com.mh.hermes-dashboard.plist ~/Library/LaunchAgents/ -->
    <key>Label</key>
    <string>com.mh.hermes-dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/mh/ai/hermes-agent/.venv/bin/python</string>
        <string>-m</string>
        <string>hermes_cli.main</string>
        <string>dashboard</string>
        <string>--tui</string>
        <string>--host</string>
        <string>100.93.233.4</string>
        <string>--port</string>
        <string>9119</string>
        <string>--no-open</string>
        <string>--skip-build</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mh/ai/hermes-agent</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/mh/.local/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/mh</string>
        <key>HERMES_WEB_DIST</key>
        <string>/Users/mh/state/releases/hermes-dashboard/current/web_dist</string>
        <key>HERMES_TUI_DIR</key>
        <string>/Users/mh/state/releases/hermes-dashboard/current/ui-tui</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/mh/.hermes/logs/dashboard.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mh/.hermes/logs/dashboard.log</string>
</dict>
</plist>
