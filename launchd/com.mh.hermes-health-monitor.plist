<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mh.hermes-health-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/mh/ai/agents/hermes-agent/.venv/bin/python</string>
        <string>/Users/mh/ai/agents/hermes-agent/scripts/hermes_health_monitor.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mh/ai/agents/hermes-agent</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/mh</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/mh/.hermes/logs/health-monitor.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mh/.hermes/logs/health-monitor.log</string>
</dict>
</plist>
